<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="GitHub REST API Smoke Suite" verbose="1" parallel="none">

    <test name="Smoke Tests">
        <groups>
            <run>
                <include name="smoke"/>
            </run>
        </groups>

        <classes>
            <class name="com.alona.qa.tests.GitHubUserApiTest"/>
            <class name="com.alona.qa.tests.RepositoryApiTest"/>
            <class name="com.alona.qa.tests.RateLimitApiTest"/>
        </classes>
    </test>

</suite>